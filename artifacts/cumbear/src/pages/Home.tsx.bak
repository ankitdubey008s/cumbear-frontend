                    setUserPreference(pref); 
                    localStorage.setItem("user_preference", pref);
                    setShowPreferenceModal(false); 
                  }}
                  className={cn("py-2.5 rounded-xl font-medium uppercase text-xs transition-all border", userPreference === pref ? "bg-red-600 border-red-500 text-white" : "bg-zinc-900 border-zinc-800 text-zinc-400")}
                >

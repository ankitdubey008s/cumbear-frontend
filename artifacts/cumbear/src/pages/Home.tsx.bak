            <h2 className="text-xs font-bold uppercase tracking-wider mb-4 text-white">Switch Pipeline Feed</h2>
            <div className="flex flex-col gap-2">
              {["Straight", "Gay", "Trans"].map(pref => (
                <button 
                  key={pref}

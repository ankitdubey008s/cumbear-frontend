              ))}
            </div>
            <button onClick={() => setShowPreferenceModal(false)} className="mt-4 text-[10px] uppercase font-mono tracking-widest text-zinc-500">Cancel</button>
          </div>
        </div>
      )}

      {/* Category Scroll Filter Bar */}
      <div className="bg-[#09090b] border-b border-zinc-800 sticky top-[57px] z-40">
        <div className="flex overflow-x-auto gap-2 px-4 py-2.5 hide-scrollbar">
          <style>{`.hide-scrollbar::-webkit-scrollbar { display: none; }`}</style>
          {CATEGORIES_SCROLL.map((cat, idx) => (
            <button
              key={cat + idx}

    return localStorage.getItem("user_preference") || defaultPreference || "Straight";
  });

  const [, navigate] = useLocation();

  useEffect(() => {
    let isMounted = true;
    setIsLoading(true);

    const fetchVideos = async () => {
      try {
        const url = `${import.meta.env.VITE_API_URL}/api/videos?pipeline=${userPreference.toLowerCase()}&q=${encodeURIComponent(activeCategory)}&limit=100`;
        const response = await fetch(url);
        const data = await response.json();

        if (isMounted && data.videos) {
          // Enhancing backend feeds to seamlessly blend elite provider tags and enforce high premium view counts
      const normalizedFeeds = data.videos.map((vid: any) => ({
        ...vid,
        thumb: vid.thumbnail_url || vid.thumb || vid.poster || "",
        provider: vid.provider || vid.source_platform || "Premium",
        views: vid.views || Math.floor(Math.random() * 5000000)
      }));
      setVideos(normalizedFeeds);
          setVideos(premiumFeeds);
        }
      } catch (err) {
        console.error(err);
      } finally {
        if (isMounted) setIsLoading(false);
      }
    };

    fetchVideos();
    return () => { isMounted = false; };
  }, [activeCategory, userPreference]);

  return (
    <div className="min-h-screen bg-[#09090b] pb-28 pt-20 text-zinc-100 font-sans select-none antialiased">
      
      {/* Top Navigation Bar */}
      <div className="fixed top-0 left-0 right-0 z-50 bg-[#121214] border-b border-zinc-800 px-4 py-3 flex items-center justify-between shadow-md">

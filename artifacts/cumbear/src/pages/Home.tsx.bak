          <span className="bg-[#09090b] border border-zinc-800 px-3 py-1.5 rounded-md tracking-wider text-zinc-400 uppercase font-bold">ADS ZONE • 728 x 120</span>
        </div>

        {/* Categories Thumbnail Matrix */}
        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
          {FEATURED_CATEGORIES.map((cat, idx) => {
            const isCardAd = cat.type === "ad";
            return (
              <div 
                key={cat.name + idx} 
                onClick={() => { 
                  if (isCardAd) { window.open("https://www.juicyads.com", "_blank"); } 

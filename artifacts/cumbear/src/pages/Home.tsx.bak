function VideoCardUI({ video, onNavigate }: { video: any; onNavigate: () => void }) {
  const [preview, setPreview] = useState(false);
  const timer = useRef<NodeJS.Timeout | null>(null);
  const previewUrl = `${video.embed_url}${video.embed_url.includes('?') ? '&' : '?'}autoplay=1&muted=1&controls=0&logo=0`;

  return (
    <div
      className="flex flex-col gap-2 cursor-pointer group relative"
      onPointerDown={() => { timer.current = setTimeout(() => setPreview(true), 350); }}
      onPointerUp={() => { if (timer.current) clearTimeout(timer.current); if (!preview) onNavigate(); else setPreview(false); }}
      onPointerLeave={() => { if (timer.current) clearTimeout(timer.current); setPreview(false); }}
      onPointerCancel={() => { if (timer.current) clearTimeout(timer.current); setPreview(false); }}
    >
      <div className="relative aspect-video bg-[#121214] rounded-2xl overflow-hidden border border-zinc-800 transition-colors">
        {!preview ? (
          <img src={video.thumb} alt="" className="w-full h-full object-cover" />
        ) : (
          <div className="absolute inset-0 pointer-events-none bg-black">
            <iframe src={previewUrl} className="w-full h-full border-none scale-[1.03]" allow="autoplay; muted" />
          </div>
        )}
        <div className="absolute bottom-2 right-2 bg-black/80 font-mono text-[9px] font-bold px-1.5 py-0.5 rounded text-zinc-300">
          {Math.floor(video.duration / 60)}:{(video.duration % 60).toString().padStart(2, '0')}
        </div>
        
        {/* Dynamic Premium High-Quality View Badge */}
        <div className="absolute top-2 left-2 bg-black/70 border border-zinc-800 font-mono text-[8px] font-bold px-1.5 py-0.5 rounded text-red-500 uppercase tracking-widest">
          HD 1080P
        </div>
      </div>
      
      <div className="flex flex-col min-w-0 px-0.5">
        <h3 className="text-xs font-semibold text-zinc-300 line-clamp-2 leading-snug group-hover:text-red-500 transition-colors tracking-tight">{video.title}</h3>
        
        {/* Meta layout row showing premium provider and filtered 100k+ analytics */}
        <div className="flex items-center justify-between mt-1 text-[9px] uppercase font-mono tracking-wider text-zinc-500">
          <span className="text-red-400 font-semibold truncate max-w-[110px]">{video.provider || "Premium"}</span>
          <span>
            {video.views >= 1000000 ? (video.views / 1000000).toFixed(1) + "M" : (video.views / 1000).toFixed(0) + "K"} VIEWS
          </span>
        </div>
      </div>
    </div>
  );
}
